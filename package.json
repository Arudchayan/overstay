{
  "name": "overstay",
  "version": "0.2.1",
  "private": true,
  "description": "Know where your time goes, and when you've overstayed. A private, local-only browser extension that tracks time per website and enforces daily limits.",
  "license": "MIT",
  "type": "module",
  "author": "Arudchayan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arudchayan/overstay.git"
  },
  "homepage": "https://github.com/Arudchayan/overstay#readme",
  "bugs": "https://github.com/Arudchayan/overstay/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:e2e && playwright test",
    "lint:firefox": "npm run build:firefox && web-ext lint --source-dir .output/firefox-mv3",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "store-assets": "npm run build && node scripts/screenshots.mjs store"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "chart.js": "^4.6.2",
    "preact": "^10.29.8",
    "tldts": "^7.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@webext-core/fake-browser": "^2.0.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
